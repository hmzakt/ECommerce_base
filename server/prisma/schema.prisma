// ════════════════════════════════════════════════════════════════════════════════
// Prisma Schema — E-Commerce Backend
//
// Design decisions:
//  - UUIDs as primary keys: avoids enumeration attacks, safe for distributed systems
//  - refreshTokenHash stored hashed: raw tokens never touch the database
//  - passwordResetToken + expiry: self-contained password reset without a separate table
//  - Explicit @@map("users"): table name is decoupled from model name
//  - Indexes on email (unique lookup) and role (admin panel filtering)
//  - createdAt/updatedAt via @default(now()) and @updatedAt
// ════════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

// ────────────────────────────────────────────────────────────────────────────────
// User model
// ────────────────────────────────────────────────────────────────────────────────

model User {
  // Primary key — UUID v4, generated by the database
  id String @id @default(uuid()) @db.Uuid

  // Auth credentials
  email        String  @unique
  passwordHash String? @map("password_hash") // nullable for OAuth-only accounts

  // OAuth
  googleId     String? @unique @map("google_id")
  authProvider String  @default("LOCAL") @map("auth_provider") // LOCAL | GOOGLE

  // Profile
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  phone     String?

  // Authorization
  role Role @default(CUSTOMER)

  // Account state
  isEmailVerified Boolean @default(false) @map("is_email_verified")
  isActive        Boolean @default(true)  @map("is_active")

  // Refresh token — stored hashed; null means no active session
  refreshTokenHash String? @map("refresh_token_hash")

  // Password reset — self-contained; no separate table needed at this scale
  passwordResetToken   String?   @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  // Relations
  cart      Cart?     // reverse relation — not a new column
  orders    Order[]   // reverse relation — not a new column

  // Explicit table name
  @@map("users")

  // Indexes
  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([createdAt])
  @@index([googleId])
}

// ────────────────────────────────────────────────────────────────────────────────
// Category model
// ────────────────────────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@map("categories")
  @@index([slug])
  @@index([isActive])
}

// ────────────────────────────────────────────────────────────────────────────────
// Product model
// ────────────────────────────────────────────────────────────────────────────────

model Product {
  id               String         @id @default(uuid()) @db.Uuid
  name             String
  slug             String         @unique
  shortDescription String?        @map("short_description")
  description      String?
  sku              String         @unique
  brand            String
  price            Decimal        @db.Decimal(10, 2)
  compareAtPrice   Decimal?       @map("compare_at_price") @db.Decimal(10, 2)
  costPrice        Decimal?       @map("cost_price") @db.Decimal(10, 2)
  categoryId       String         @map("category_id") @db.Uuid
  isActive         Boolean        @default(true) @map("is_active")
  isFeatured       Boolean        @default(false) @map("is_featured")
  weight           Decimal?       @db.Decimal(10, 3)
  length           Decimal?       @db.Decimal(10, 2)
  breadth          Decimal?       @db.Decimal(10, 2)
  height           Decimal?       @db.Decimal(10, 2)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images           ProductImage[]
  cartItems        CartItem[]     // reverse relation — not a new column
  orderItems       OrderItem[]    // reverse relation — not a new column

  @@map("products")
  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([price])
  @@index([isActive])
  @@index([isFeatured])
}

// ────────────────────────────────────────────────────────────────────────────────
// ProductImage model
// ────────────────────────────────────────────────────────────────────────────────

model ProductImage {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  url          String
  alt          String?
  displayOrder Int      @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
  @@index([productId])
}

// ────────────────────────────────────────────────────────────────────────────────
// Cart model
// One active cart per user (userId is @unique).
// Cascade-deletes all CartItems when the cart is deleted.
// ────────────────────────────────────────────────────────────────────────────────

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @map("user_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
  @@index([userId])
}

// ────────────────────────────────────────────────────────────────────────────────
// CartItem model
// @@unique([cartId, productId]) prevents duplicate products per cart at DB level.
// onDelete: Cascade on cart  — items vanish when cart is cleared/deleted.
// onDelete: Restrict on product — prevents silent orphans if product is removed.
// ────────────────────────────────────────────────────────────────────────────────

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@map("cart_items")
  @@index([cartId])
  @@index([productId])
}

// ────────────────────────────────────────────────────────────────────────────────
// Order Enums
// ────────────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ────────────────────────────────────────────────────────────────────────────────
// Order model
// ────────────────────────────────────────────────────────────────────────────────

model Order {
  id              String           @id @default(uuid()) @db.Uuid
  orderNumber     String           @unique @map("order_number")
  userId          String           @map("user_id") @db.Uuid
  status          OrderStatus      @default(PENDING)
  paymentStatus   PaymentStatus    @default(PENDING) @map("payment_status")
  subtotal        Decimal          @db.Decimal(10, 2)
  shippingCost    Decimal          @default(0.00) @map("shipping_cost") @db.Decimal(10, 2)
  tax             Decimal          @default(0.00) @db.Decimal(10, 2)
  total           Decimal          @db.Decimal(10, 2)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  shippingAddress ShippingAddress?
  payment         Payment?
  shipping        Shipping?         // Legacy shipping record
  shipments       Shipment[]        // Full logistics shipments
  shippingAttempts ShippingAttempt[] // Audited shipping operations

  @@map("orders")
  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
}

// ────────────────────────────────────────────────────────────────────────────────
// ShippingAddress model (1:1 with Order)
// ────────────────────────────────────────────────────────────────────────────────

model ShippingAddress {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @unique @map("order_id") @db.Uuid
  fullName      String   @map("full_name")
  streetAddress String   @map("street_address")
  apartment     String?
  city          String
  state         String
  postalCode    String   @map("postal_code")
  country       String
  phone         String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shipping_addresses")
}

// ────────────────────────────────────────────────────────────────────────────────
// OrderItem model (Immutable snapshot of product at time of purchase)
// ────────────────────────────────────────────────────────────────────────────────

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  productName String   @map("product_name")
  productSku  String   @map("product_sku")
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal  @map("line_total") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
  @@index([orderId])
  @@index([productId])
}

// ────────────────────────────────────────────────────────────────────────────────
// Payment model (1:1 with Order)
// ────────────────────────────────────────────────────────────────────────────────

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @unique @map("order_id") @db.Uuid
  razorpayOrderId   String        @unique @map("razorpay_order_id")
  razorpayPaymentId String?       @unique @map("razorpay_payment_id")
  razorpaySignature String?       @map("razorpay_signature")
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  method            String?
  rawWebhookPayload Json?         @map("raw_webhook_payload")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
  @@index([orderId])
  @@index([razorpayOrderId])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────────
// Shipping Enums & Models
// ────────────────────────────────────────────────────────────────────────────────

enum ShippingStatus {
  PENDING
  PACKED
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

model Shipping {
  id               String         @id @default(uuid()) @db.Uuid
  orderId          String         @unique @map("order_id") @db.Uuid
  trackingNumber   String?        @map("tracking_number")
  shippingProvider String?        @map("shipping_provider")
  estimatedDelivery DateTime?     @map("estimated_delivery")
  actualDelivery   DateTime?      @map("actual_delivery")
  status           ShippingStatus @default(PENDING)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shippings")
  @@index([orderId])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────────
// Production Logistics Domain Models (Phase 1)
// ────────────────────────────────────────────────────────────────────────────────

enum ShipmentStatus {
  PENDING
  PROCESSING
  SHIPMENT_CREATED
  AWB_ASSIGNED
  PICKUP_REQUESTED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RTO_INITIATED
  RTO_DELIVERED
  CANCELLED
  EXCEPTION
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

// ── Shipment Model ─────────────────────────────────────────────────────────────
model Shipment {
  id                  String            @id @default(uuid()) @db.Uuid
  orderId             String            @map("order_id") @db.Uuid
  shippingProvider    String            @default("SHIPROCKET") @map("shipping_provider")
  courierName         String?           @map("courier_name")
  courierCompanyId    Int?              @map("courier_company_id")
  externalShipmentId  String?           @map("external_shipment_id")
  externalOrderId     String?           @map("external_order_id")
  awbCode             String?           @map("awb_code")
  trackingUrl         String?           @map("tracking_url")
  status              ShipmentStatus    @default(PENDING)
  shippingCost        Decimal           @default(0.00) @map("shipping_cost") @db.Decimal(10, 2)
  currency            String            @default("INR")
  weight              Decimal           @default(0.500) @db.Decimal(10, 3) // Weight in kg
  length              Decimal?          @db.Decimal(10, 2) // Dimensions in cm
  breadth             Decimal?          @db.Decimal(10, 2)
  height              Decimal?          @db.Decimal(10, 2)
  pickupLocation      String?           @map("pickup_location")
  destinationSnapshot Json?             @map("destination_snapshot")
  estimatedDelivery   DateTime?         @map("estimated_delivery")
  actualDelivery      DateTime?         @map("actual_delivery")
  labelUrl            String?           @map("label_url")
  manifestUrl         String?           @map("manifest_url")
  invoiceUrl          String?           @map("invoice_url")
  pickupRequestId     String?           @map("pickup_request_id")
  pickupScheduledDate DateTime?         @map("pickup_scheduled_date")
  selectionStrategy   String?           @map("selection_strategy")
  selectionReason     String?           @map("selection_reason")
  isActive            Boolean           @default(true) @map("is_active")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  order               Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events              ShipmentEvent[]
  attempts            ShippingAttempt[]

  @@map("shipments")
  @@index([orderId])
  @@index([awbCode])
  @@index([status])
  @@index([externalShipmentId])
  @@index([isActive])
  @@index([createdAt])
}

// ── ShipmentEvent Model ────────────────────────────────────────────────────────
model ShipmentEvent {
  id               String         @id @default(uuid()) @db.Uuid
  shipmentId       String         @map("shipment_id") @db.Uuid
  eventCode        String?        @map("event_code")
  eventStatus      String         @map("event_status")
  eventDescription String         @map("event_description")
  eventLocation    String?        @map("event_location")
  eventTimestamp   DateTime       @map("event_timestamp")
  eventSource      String         @default("SYSTEM") @map("event_source") // SHIPROCKET, SYSTEM, ADMIN
  externalEventId  String?        @map("external_event_id")
  rawPayload       Json?          @map("raw_payload")
  createdAt        DateTime       @default(now()) @map("created_at")

  shipment         Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, externalEventId])
  @@map("shipment_events")
  @@index([shipmentId])
  @@index([eventTimestamp])
}

// ── ShippingProvider Model ─────────────────────────────────────────────────────
model ShippingProvider {
  id                String   @id @default(uuid()) @db.Uuid
  code              String   @unique // SHIPROCKET, DELHIVERY, EKART, INDIAPOST
  name              String
  providerType      String   @default("AGGREGATOR") @map("provider_type") // AGGREGATOR, DIRECT
  isActive          Boolean  @default(true) @map("is_active")
  environment       String   @default("SANDBOX") // SANDBOX, PRODUCTION
  credentialsCipher String?  @map("credentials_cipher") // AES-256-GCM encrypted credentials
  config            Json?    @default("{}")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("shipping_providers")
  @@index([code])
  @@index([isActive])
}

// ── ShippingSettings Model ─────────────────────────────────────────────────────
model ShippingSettings {
  id                       String   @id @default(uuid()) @db.Uuid
  autoCreateShipment       Boolean  @default(true) @map("auto_create_shipment")
  defaultProviderCode      String   @default("SHIPROCKET") @map("default_provider_code")
  allowedCouriers          Json?    @map("allowed_couriers")
  courierSelectionStrategy String   @default("BALANCED") @map("courier_selection_strategy") // CHEAPEST, FASTEST, BALANCED
  strategyWeights          Json?    @map("strategy_weights")
  preferredCourierId       String?  @map("preferred_courier_id")
  freeShippingThreshold    Decimal  @default(0.00) @map("free_shipping_threshold") @db.Decimal(10, 2)
  warehouseAddress         Json     @map("warehouse_address")
  defaultPackageWeight     Decimal  @default(0.500) @map("default_package_weight") @db.Decimal(10, 3)
  defaultPackageDimensions Json     @map("default_package_dimensions")
  retryPolicy              Json     @map("retry_policy")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("shipping_settings")
}

// ── ShippingAttempt Model ──────────────────────────────────────────────────────
model ShippingAttempt {
  id              String    @id @default(uuid()) @db.Uuid
  orderId         String    @map("order_id") @db.Uuid
  shipmentId      String?   @map("shipment_id") @db.Uuid
  provider        String
  operation       String    // CREATE_SHIPMENT, GENERATE_AWB, REQUEST_PICKUP, CANCEL_SHIPMENT, TRACK
  attemptNumber   Int       @default(1) @map("attempt_number")
  correlationId   String    @map("correlation_id")
  status          String    // SUCCESS, FAILED
  errorCode       String?   @map("error_code")
  errorMessage    String?   @map("error_message")
  requestPayload  Json?     @map("request_payload")
  responsePayload Json?     @map("response_payload")
  createdAt       DateTime  @default(now()) @map("created_at")

  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipment        Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@map("shipping_attempts")
  @@index([orderId])
  @@index([shipmentId])
  @@index([correlationId])
  @@index([status])
}

// ── OutboxEvent Model (Transactional Outbox Pattern) ───────────────────────────
model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  eventType     String       @map("event_type") // ORDER_CONFIRMED_FOR_SHIPMENT, etc.
  aggregateType String       @default("ORDER") @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  payload       Json
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0) @map("retry_count")
  maxRetries    Int          @default(5) @map("max_retries")
  nextRetryAt   DateTime?    @map("next_retry_at")
  lastError     String?      @map("last_error")
  lockedAt      DateTime?    @map("locked_at")
  lockedBy      String?      @map("locked_by")
  createdAt     DateTime     @default(now()) @map("created_at")
  processedAt   DateTime?    @map("processed_at")

  @@map("outbox_events")
  @@index([status, nextRetryAt])
  @@index([aggregateId])
  @@index([createdAt])
}


