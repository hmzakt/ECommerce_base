{
  "name": "e-com-2",
  "version": "1.0.0",
  "description": "Production-grade e-commerce backend for home decor & beauty products",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "worker:shipping": "node src/modules/shipping/workers/worker.runner.js",
    "test": "node --test tests/**/*.test.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:seed-logistics": "node prisma/seed-logistics.js",
    "db:bootstrap-admin": "node prisma/bootstrap-admin.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "cloudinary": "^2.10.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "nodemailer": "^9.0.5",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "razorpay": "^2.9.5",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "nodemonConfig": {
    "watch": [
      "src",
      "prisma"
    ],
    "ext": "js,prisma",
    "ignore": [
      "node_modules"
    ]
  }
}
